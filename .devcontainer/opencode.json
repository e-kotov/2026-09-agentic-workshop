{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "workshop": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Workshop fallback",
      "options": {
        "baseURL": "https://diw-workshop-proxy.ekotov.workers.dev/v1",
        "apiKey": "{env:WORKSHOP_API_KEY}"
      },
      "models": {
        "zai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "cost": {
            "input": 0.05,
            "output": 0.15,
            "cache": {
              "read": 0.02,
              "write": 0
            }
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
